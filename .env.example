# For google oauth and login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# For app emails including auth, system emails, logging and debugging
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# For storing images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=

AWS_PROFILE= ??

# For securing your sessions
SECRET_KEY=

# Database - main application database
DATABASE_URL=postgresql://localhost/lurnby

# Test database - used by pytest (must be different from DATABASE_URL)
TEST_DATABASE_URL=postgresql://localhost/lurnby-test

# Name of the main app database (used by tests to prevent accidental drops)
# This should match the database name in DATABASE_URL
APP_DATABASE_NAME=lurnby

# Redis connection for background tasks
REDIS_URL=redis://

# For generating recent highlights emails
SERVER_NAME=http://localhost:3000

# Set to any value to enable staging mode (shows staging banner)
# DEV=1

# Logging: set to any value to log to stdout instead of file
# LOG_TO_STDOUT=1
